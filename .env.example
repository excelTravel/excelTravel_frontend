# ── excelTravel frontend — copy to .env.local and fill in. NEVER commit the real .env ──

# Backend API base URL — INCLUDE the /api/v1 prefix (hooks use resource paths like /trips, /vehicles).
# Live: http://13.140.133.61:3300/api/v1   ·   Local dev: http://localhost:3000/api/v1
VITE_API_BASE_URL=http://13.140.133.61:3300/api/v1

# Socket.io server — the backend host WITHOUT /api/v1 (usually the same host as the API).
VITE_SOCKET_URL=http://13.140.133.61:3300

# Clerk (auth) — publishable key from the Clerk dashboard (safe to expose; NOT the secret key).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Cloudinary (image uploads — company logo, incident/parcel photos, avatars).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# MapLibre style URL (free OSM/MapTiler style). Optional — a default OSM raster style is used if unset.
VITE_MAP_STYLE_URL=
